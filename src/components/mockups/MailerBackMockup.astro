---
/**
 * Example back of a shared postcard: more ad spaces plus the address area.
 * A photo of the blank card with live text laid over its panels
 * (coordinates in the photo's pixel space, 1586 × 992). Fictional businesses.
 */
import { getImage } from 'astro:assets';
import backPhoto from '../../assets/images/examples/example-postcard-back.webp';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const uid = `back-${Math.random().toString(36).slice(2, 8)}`;
const photo = await getImage({ src: backPhoto, width: 1400, format: 'webp', quality: 80 });
const ads = [
  { kind: 'FLORIST', name: 'Petal & Stem', line: 'Same-week bouquets', fg: '#121c30' },
  { kind: 'FITNESS', name: 'Upstairs Studio', line: 'Beginner classes', fg: '#1c2a44' },
  { kind: 'BAKERY', name: 'Maple & Rye', line: 'Weekend pastries', fg: '#121c30' },
];
const rows = [159, 388, 616];
---
<svg class:list={['mailer-back', className]} viewBox="170 100 1246 790" role="img" aria-labelledby={`${uid}-t ${uid}-d`}>
  <title id={`${uid}-t`}>Example layout of the back of a shared postcard</title>
  <desc id={`${uid}-d`}>
    The back of a shared mailer with three more ad spaces on the left and a blank address and postage area on the right.
  </desc>
  <image href={photo.src} x="0" y="0" width="1586" height="992" preserveAspectRatio="none"></image>
  {
    ads.map((ad, i) => (
      <g transform={`translate(231 ${rows[i]})`}>
        <text x="30" y="50" class="m-body" font-size="17" font-weight="700" letter-spacing="2.4" fill={ad.fg} opacity="0.75">{ad.kind}</text>
        <text x="30" y="120" class="m-display" font-size="42" fill={ad.fg}>{ad.name}</text>
        <text x="30" y="162" class="m-body" font-size="24" fill={ad.fg}>{ad.line}</text>
      </g>
    ))
  }
  <text x="1263" y="270" text-anchor="middle" class="m-body" font-size="18" fill="#525866">Postage</text>
  <text x="846" y="488" class="m-body" font-size="18" font-weight="700" letter-spacing="2.6" fill="#525866">ADDRESS AREA</text>
  <text x="846" y="790" class="m-body" font-size="19" fill="#525866">Organized by Post &amp; Board Media</text>
</svg>

<style>
  .mailer-back {
    width: 100%;
    height: auto;
    border-radius: 12px;
  }
  .m-display {
    font-family: var(--font-display);
    font-weight: 600;
  }
  .m-body {
    font-family: var(--font-body);
  }
</style>
