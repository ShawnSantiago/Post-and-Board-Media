---
/**
 * Example shared postcard (one side) with several clearly separated
 * advertisers. All businesses shown are fictional.
 */
import { getImage } from 'astro:assets';
import householdPhoto from '../../assets/images/examples/example-postcard-household.webp';
interface Props {
  class?: string;
  highlight?: number;
  variant?: 'household' | 'business';
}
const { class: className, highlight, variant = 'household' } = Astro.props;
const uid = `card-${Math.random().toString(36).slice(2, 8)}`;

const householdAds = [
  { kind: 'LANDSCAPING', name: 'Greenway Yards', line: 'Spring clean-ups', bg: '#dde4ee', fg: '#1c2a44', dot: '#2c3f63' },
  { kind: 'DENTAL', name: 'Brightside', line: 'New patients welcome', bg: '#fffcf6', fg: '#1c2a44', dot: '#c8452f' },
  { kind: 'PIZZERIA', name: 'Corner Slice', line: 'Order for pickup', bg: '#e9b949', fg: '#121c30', dot: '#a33624' },
  { kind: 'PET GROOMING', name: 'Tidy Paws', line: 'Walk-ins on Saturdays', bg: '#f6dcd5', fg: '#121c30', dot: '#c8452f' },
  { kind: 'TUTORING', name: 'Northstar', line: 'Grades 1 to 12', bg: '#fffcf6', fg: '#1c2a44', dot: '#2c3f63' },
  { kind: 'HVAC', name: 'Steadyheat', line: 'Furnace tune-ups', bg: '#1c2a44', fg: '#fffcf6', dot: '#e9b949' },
];
const businessAds = [
  { kind: 'OFFICE CLEANING', name: 'Brightline', line: 'Evening crews', bg: '#dde4ee', fg: '#1c2a44', dot: '#2c3f63' },
  { kind: 'IT SUPPORT', name: 'Keystone IT', line: 'Small-office help', bg: '#fffcf6', fg: '#1c2a44', dot: '#c8452f' },
  { kind: 'CATERING', name: 'Longtable', line: 'Team lunches', bg: '#e9b949', fg: '#121c30', dot: '#a33624' },
  { kind: 'SIGNAGE', name: 'Tallpost Signs', line: 'Storefront signs', bg: '#f6dcd5', fg: '#121c30', dot: '#c8452f' },
  { kind: 'BOOKKEEPING', name: 'Ledgerwise', line: 'Monthly bookkeeping', bg: '#fffcf6', fg: '#1c2a44', dot: '#2c3f63' },
  { kind: 'COURIER', name: 'Quickstep', line: 'Same-day local runs', bg: '#1c2a44', fg: '#fffcf6', dot: '#e9b949' },
];
const ads = variant === 'business' ? businessAds : householdAds;
const heading = variant === 'business' ? 'Local services for your business' : 'Good neighbours, nearby';

// Photo of a blank printed postcard; the live text below is laid over its
// panels. Coordinates are in the photo's own pixel space (1586 × 992).
const photo = await getImage({ src: householdPhoto, width: 1400, format: 'webp', quality: 80 });
const cols = [
  { x: 296, w: 321 },
  { x: 635, w: 324 },
  { x: 976, w: 316 },
];
const rows = [334, 567];
const H = 219;
const pos = (i: number) => ({ ...cols[i % 3], y: rows[Math.floor(i / 3)] });
---
<svg class:list={['postcard', className]} viewBox="226 128 1140 736" role="img" aria-labelledby={`${uid}-t ${uid}-d`}>
  <title id={`${uid}-t`}>Example layout of a shared postcard</title>
  <desc id={`${uid}-d`}>
    One side of a shared mailer divided into six equal, clearly separated ad spaces for fictional local businesses.
  </desc>
  <image href={photo.src} x="0" y="0" width="1586" height="992" preserveAspectRatio="none"></image>
  <text x="301" y="254" class="p-display" font-size="50" fill="#fffcf6">{heading}</text>
  <text x="1288" y="250" text-anchor="end" class="p-body" font-size="19" font-weight="700" letter-spacing="3" fill="#e9b949">SHARED MAILER</text>
  {
    ads.map((ad, i) => {
      const p = pos(i);
      const isHi = highlight === i;
      return (
        <g transform={`translate(${p.x} ${p.y})`}>
          {isHi ? (
            <>
              <rect x="2" y="2" width={p.w - 4} height={H - 4} rx="10" fill="#fffcf6" stroke="#c8452f" stroke-width="5" stroke-dasharray="16 12" />
              <text x={p.w / 2} y="112" text-anchor="middle" class="p-display" font-size="38" fill="#1c2a44">Your ad here</text>
              <text x={p.w / 2} y="152" text-anchor="middle" class="p-body" font-size="22" fill="#525866">One defined space</text>
            </>
          ) : (
            <>
              <text x="58" y="38" class="p-body" font-size="16.5" font-weight="700" letter-spacing="2.4" fill={ad.fg} opacity="0.75">{ad.kind}</text>
              <text x="22" y="130" class="p-display" font-size="36" fill={ad.fg}>{ad.name}</text>
              <text x="22" y="170" class="p-body" font-size="22" fill={ad.fg}>{ad.line}</text>
            </>
          )}
        </g>
      );
    })
  }
</svg>

<style>
  .postcard {
    width: 100%;
    height: auto;
    border-radius: 12px;
  }
  .p-display {
    font-family: var(--font-display);
    font-weight: 600;
  }
  .p-body {
    font-family: var(--font-body);
  }
</style>
