---
/**
 * Example storefront (sidewalk) sign: a large host area for the business's own
 * specials and a smaller sponsor section. A photo of the blank printed board with
 * live text laid over it (coordinates in the photo's pixel space, 1086 × 1448).
 * All businesses shown are fictional.
 */
import { getImage } from 'astro:assets';
import boardPhoto from '../../assets/images/examples/example-board.webp';

interface Props {
  class?: string;
  /** Highlight one advertiser panel (0-3) to show "your ad here". */
  highlight?: number;
}
const { class: className, highlight } = Astro.props;
const uid = `board-${Math.random().toString(36).slice(2, 8)}`;
const photo = await getImage({ src: boardPhoto, width: 1000, format: 'webp', quality: 80 });

const specials = [
  ['Lunch combo', 'Until 2 pm'],
  ['Soup of the day', 'Squash & ginger'],
  ['Iced maple latte', 'Seasonal'],
  ['Trivia night', 'Thursdays'],
];
const ads = [
  { name: 'Maple & Rye', kind: 'BAKERY', line: 'Fresh bread daily', fg: '#121c30', accent: '#a33624' },
  { name: 'Northend Bikes', kind: 'REPAIR SHOP', line: 'Tune-ups & repairs', fg: '#1c2a44', accent: '#c8452f' },
  { name: 'Clearview', kind: 'EYE CARE', line: 'Booking eye exams', fg: '#1c2a44', accent: '#2c3f63' },
  { name: 'Harbourline', kind: 'PLUMBING', line: 'Licensed & local', fg: '#fffcf6', accent: '#e9b949' },
];
// Panel boxes measured from the photo.
const panels = [
  { x: 212, y: 833, w: 318, h: 148 },
  { x: 558, y: 833, w: 316, h: 148 },
  { x: 212, y: 1005, w: 318, h: 152 },
  { x: 556, y: 1005, w: 318, h: 152 },
];
---
<svg class:list={['board', className]} viewBox="113 150 860 1120" role="img" aria-labelledby={`${uid}-t ${uid}-d`}>
  <title id={`${uid}-t`}>Example layout of a storefront sign</title>
  <desc id={`${uid}-d`}>
    A sidewalk sign outside a café. The top two-thirds shows the host’s own specials. The bottom sponsor section holds
    four clearly separated ads from fictional local businesses.
  </desc>
  <image href={photo.src} x="0" y="0" width="1086" height="1448" preserveAspectRatio="none"></image>

  <!-- host area -->
  <text x="543" y="282" text-anchor="middle" class="b-display" font-size="66" fill="#fffcf6">Today’s Specials</text>
  <g class="b-body">
    {
      specials.map(([item, note], i) => (
        <>
          <text x="222" y={398 + i * 72} font-size="31" fill="#eef1f6">{item}</text>
          <text x="864" y={398 + i * 72} text-anchor="end" font-size="26" fill="#e9b949">{note}</text>
        </>
      ))
    }
  </g>
  <text x="543" y="728" text-anchor="middle" class="b-display b-italic" font-size="30" fill="#c9d1de">Come inside →</text>

  <!-- advertiser band -->
  <text x="212" y="824" class="b-body" font-size="14" font-weight="700" letter-spacing="2.4" fill="#525866">LOCAL SPONSORS</text>
  <text x="874" y="824" text-anchor="end" class="b-body" font-size="14" fill="#525866">Post &amp; Board Media</text>
  {
    ads.map((ad, i) => {
      const p = panels[i];
      const isHi = highlight === i;
      return (
        <g transform={`translate(${p.x} ${p.y})`}>
          {isHi ? (
            <>
              <rect x="2" y="2" width={p.w - 4} height={p.h - 4} rx="16" fill="#fffcf6" stroke="#c8452f" stroke-width="5" stroke-dasharray="16 12" />
              <text x={p.w / 2} y={p.h / 2 + 4} text-anchor="middle" class="b-display" font-size="34" fill="#1c2a44">Your ad here</text>
              <text x={p.w / 2} y={p.h / 2 + 38} text-anchor="middle" class="b-body" font-size="19" fill="#525866">One defined space</text>
            </>
          ) : (
            <>
              <circle cx="32" cy="36" r="11" fill={ad.accent} opacity="0.9" />
              <text x="52" y="42" class="b-body" font-size="15" font-weight="700" letter-spacing="2" fill={ad.fg} opacity="0.75">{ad.kind}</text>
              <text x="20" y="98" class="b-display" font-size="35" fill={ad.fg}>{ad.name}</text>
              <text x="20" y="130" class="b-body" font-size="20" fill={ad.fg}>{ad.line}</text>
            </>
          )}
        </g>
      );
    })
  }
</svg>

<style>
  .board {
    width: 100%;
    height: auto;
    border-radius: 12px;
  }
  .b-display {
    font-family: var(--font-display);
    font-weight: 600;
  }
  .b-italic {
    font-style: italic;
    font-weight: 400;
  }
  .b-body {
    font-family: var(--font-body);
  }
</style>
