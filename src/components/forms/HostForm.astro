---
import '../../styles/forms.css';
import { site } from '../../config/site';
import { areaOptions } from '../../content/areas';
import { venueTypes } from '../../content/services';
import { deliveryConfigured } from '../../lib/delivery';
import FormConnectionNotice from './FormConnectionNotice.astro';

interface Props {
  area?: string;
  idPrefix?: string;
}
const { area, idPrefix = 'host' } = Astro.props;
const id = (name: string) => `${idPrefix}-${name}`;
const connected = deliveryConfigured();
---
<div class="enquiry" data-enquiry-wrap data-contact-email={site.contact.email ?? undefined}>
  <div class="enquiry__head">
    <h2 id={id('title')}>Apply to host a sign</h2>
    <p>Tell us about your storefront. We’ll follow up to check the spot outside your door and walk you through the host agreement.</p>
  </div>

  <FormConnectionNotice connected={connected} />

  <form method="post" action="/api/enquiry" novalidate data-enquiry-form aria-labelledby={id('title')}>
    <input type="hidden" name="formType" value="host" />
    <input type="hidden" name="sourcePage" value={Astro.url.pathname} data-source />
    <div class="hp-field" aria-hidden="true">
      <label for={id('hp')}>Leave this field empty</label>
      <input id={id('hp')} type="text" name="company_url" tabindex="-1" autocomplete="off" />
    </div>

    <div class="form-grid">
      <div class="field">
        <label for={id('venueName')}>Business name <span class="req" aria-hidden="true">*</span></label>
        <input id={id('venueName')} name="venueName" type="text" autocomplete="organization" required maxlength="160" aria-describedby={id('venueName-err')} />
        <p class="field__error" id={id('venueName-err')}></p>
      </div>
      <div class="field">
        <label for={id('name')}>Contact name <span class="req" aria-hidden="true">*</span></label>
        <input id={id('name')} name="name" type="text" autocomplete="name" required maxlength="120" aria-describedby={id('name-err')} />
        <p class="field__error" id={id('name-err')}></p>
      </div>
      <div class="field">
        <label for={id('email')}>Email <span class="req" aria-hidden="true">*</span></label>
        <input id={id('email')} name="email" type="email" autocomplete="email" required maxlength="200" aria-describedby={id('email-err')} />
        <p class="field__error" id={id('email-err')}></p>
      </div>
      <div class="field">
        <label for={id('area')}>Area <span class="req" aria-hidden="true">*</span></label>
        <select id={id('area')} name="area" required aria-describedby={id('area-err')}>
          <option value="">Choose an area</option>
          {areaOptions.filter((o) => o.value !== 'not-sure').map((o) => <option value={o.value} selected={o.value === area}>{o.label}</option>)}
        </select>
        <p class="field__error" id={id('area-err')}></p>
      </div>
      <div class="field">
        <label for={id('venueType')}>Type of business <span class="req" aria-hidden="true">*</span></label>
        <select id={id('venueType')} name="venueType" required aria-describedby={id('venueType-err')}>
          <option value="">Choose a type</option>
          {venueTypes.map((v) => <option value={v}>{v}</option>)}
        </select>
        <p class="field__error" id={id('venueType-err')}></p>
      </div>
      <div class="field">
        <label for={id('website')}>Website or social link <span class="opt">(optional)</span></label>
        <input id={id('website')} name="website" type="text" inputmode="url" maxlength="300" aria-describedby={id('website-err')} />
        <p class="field__error" id={id('website-err')}></p>
      </div>
      <div class="field">
        <label for={id('hasSign')}>Do you put a sign out now? <span class="opt">(optional)</span></label>
        <select id={id('hasSign')} name="hasSign">
          <option value="">Choose one</option>
          <option>Yes, every day</option>
          <option>Sometimes</option>
          <option>No, but I’d like to</option>
        </select>
      </div>
      <div class="field field--full">
        <label for={id('message')}>Your street and where the sign would go <span class="opt">(optional)</span></label>
        <textarea id={id('message')} name="message" rows="4" maxlength="3000" placeholder="e.g. On the sidewalk beside our front door"></textarea>
      </div>
    </div>

    <div class="enquiry__footer">
      <button class="btn btn--primary" type="submit" data-submit>
        <span class="spinner" aria-hidden="true"></span>
        <span data-submit-label>Send application</span>
      </button>
      <p class="enquiry__privacy">
        We use these details only to follow up about hosting a sign. See our <a href="/privacy">privacy notice</a>.
      </p>
    </div>
    <div class="enquiry__status" role="status" aria-live="polite" data-status></div>
  </form>

  <div class="enquiry__success" tabindex="-1" hidden data-success>
    <h2>Thanks — your application has been sent.</h2>
    <p>We’ll be in touch by email to arrange a quick look at your storefront and talk through the sign.</p>
  </div>
</div>

<script>
  import { enhanceEnquiryForms } from '../../lib/form-client';
  enhanceEnquiryForms();
</script>
