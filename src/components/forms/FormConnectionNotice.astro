---
/**
 * Developer notice for preview builds only (no production SITE_URL): tells
 * the tester the form has no delivery destination. Never rendered on the
 * production site — there, `npm run verify` fails if no destination is set.
 */
import { isPreview } from '../../lib/seo';
interface Props {
  connected: boolean;
}
const { connected } = Astro.props;
---
{
  isPreview && (
    <div class="notice notice--warn" style="margin-bottom:1.25rem" data-connection-notice hidden={connected}>
      <strong>Preview build: form destination not configured.</strong>
      Set <code>ENQUIRY_WEBHOOK_URL</code> to deliver submissions. This notice never appears on the production site.
    </div>
  )
}
