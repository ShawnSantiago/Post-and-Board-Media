---
/** Shown while no opportunities are published: invite founding advertisers. */
import { site } from '../../config/site';
import { pricing } from '../../content/pricing';
import PriceTag from '../ui/PriceTag.astro';
interface Props {
  headingLevel?: 'h2' | 'h3';
}
const { headingLevel: H = 'h2' } = Astro.props;
const H3 = H === 'h2' ? 'h3' : 'h4';
---
<div class="launch">
  <div class="launch__intro">
    <p class="chip chip--mustard chip--dot">Founding spots</p>
    <H>We’re lining up the first {site.launchCity} signs and mailers.</H>
    <p>
      Tell us your neighbourhood and category to get first pick of a founding spot. We’ll send you the details as soon as
      each campaign is listed.
    </p>
  </div>
  <div class="launch__cards">
    <div class="launch__card">
      <p class="eyebrow">Storefront signs</p>
      <H3>Founding sign sponsors</H3>
      <p>A sponsor panel on a sidewalk sign outside a {site.launchCity} storefront.</p>
      <PriceTag anchor={pricing.board} />
      <a class="btn btn--primary btn--sm" href={`/contact?format=board&area=hamilton`}>Get first pick</a>
    </div>
    <div class="launch__card launch__card--mailer">
      <p class="eyebrow">Shared mailers</p>
      <H3>Founding mailer advertisers</H3>
      <p>One spot on a shared postcard to {site.launchCity} homes or businesses.</p>
      <PriceTag anchor={pricing.mailer} />
      <a class="btn btn--primary btn--sm" href={`/contact?format=mailer&area=hamilton`}>Get first pick</a>
    </div>
  </div>
</div>

<style>
  .launch {
    display: grid;
    gap: 2rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) + 4px);
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }
  @media (min-width: 960px) {
    .launch {
      grid-template-columns: 1fr 1.4fr;
      align-items: center;
    }
  }
  .launch__intro :is(h2, h3) {
    margin-top: 0.9rem;
  }
  .launch__intro p:last-child {
    color: var(--muted);
    margin: 0;
  }
  .launch__cards {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 620px) {
    .launch__cards {
      grid-template-columns: 1fr 1fr;
    }
  }
  .launch__card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.3rem;
    border-radius: var(--radius);
    background: var(--mist);
  }
  .launch__card--mailer {
    background: #f4ddd5;
  }
  .launch__card .eyebrow {
    margin: 0;
  }
  .launch__card :is(h3, h4) {
    font-size: var(--step-1);
    margin: 0;
  }
  .launch__card p {
    margin: 0;
    font-size: 0.95rem;
  }
  .launch__card .btn {
    align-self: flex-start;
    margin-top: 0.4rem;
  }
</style>
