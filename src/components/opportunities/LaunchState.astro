---
/** Honest empty state — shown when no opportunities are published. */
import { publishedAreas } from '../../content/areas';
interface Props {
  headingLevel?: 'h2' | 'h3';
}
const { headingLevel: H = 'h2' } = Astro.props;
---
<div class="launch">
  <div class="launch__text">
    <p class="chip chip--mustard chip--dot">Launch stage</p>
    <H>We’re organizing our first placements.</H>
    <p>
      Tell us your preferred area and advertising format. Your enquiry helps decide where the first boards go and which
      mailer campaigns we plan first — and we’ll contact you when something suitable is confirmed.
    </p>
    <div class="btn-row">
      <a class="btn btn--primary" href="/contact">Tell us your area</a>
      <a class="btn btn--ghost" href="/host-a-board">Suggest a host venue</a>
    </div>
  </div>
  <div class="launch__quick">
    <p class="launch__label" id="quick-label">Start with an area</p>
    <ul aria-labelledby="quick-label">
      {
        publishedAreas.map((a) => (
          <li>
            <a href={`/contact?area=${a.slug}`}>{a.name}</a>
          </li>
        ))
      }
      <li><a href="/contact?area=other">Somewhere else</a></li>
    </ul>
  </div>
</div>

<style>
  .launch {
    display: grid;
    gap: 2rem;
    background: var(--paper);
    border: 2px dashed var(--line);
    border-radius: calc(var(--radius) + 4px);
    padding: clamp(1.5rem, 4vw, 2.75rem);
  }
  @media (min-width: 880px) {
    .launch {
      grid-template-columns: 1.5fr 1fr;
      align-items: center;
    }
  }
  .launch h2,
  .launch h3 {
    margin-top: 0.9rem;
  }
  .launch__label {
    font-weight: 600;
    color: var(--navy);
    margin-bottom: 0.6rem;
  }
  .launch__quick ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.5rem;
  }
  .launch__quick a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.8rem 1rem;
    border-radius: var(--radius-sm);
    background: var(--cream);
    text-decoration: none;
    font-weight: 600;
  }
  .launch__quick a::after {
    content: '→';
  }
  .launch__quick a:hover {
    background: var(--mist);
    color: var(--navy);
  }
</style>
