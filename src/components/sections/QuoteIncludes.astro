---
import { quoteIncludes, type PriceRecord } from '../../content/pricing';
import PriceTag from '../ui/PriceTag.astro';
interface Props {
  price: PriceRecord;
  cta: { href: string; label: string };
}
const { price, cta } = Astro.props;
---
<div class="quote card">
  <div class="quote__price">
    <p class="eyebrow">Pricing</p>
    <PriceTag anchor={price} size="lg" />
    <p class="quote__note">Exact prices are listed on each opportunity.</p>
    <a class="btn btn--primary" href={cta.href}>{cta.label}</a>
  </div>
  <div>
    <h3 class="quote__title">Your quote confirms</h3>
    <ul class="checklist">
      {quoteIncludes.map((q) => <li>{q}</li>)}
    </ul>
  </div>
</div>

<style>
  .quote {
    display: grid;
    gap: 1.5rem 3rem;
  }
  @media (min-width: 820px) {
    .quote {
      grid-template-columns: 0.9fr 1.1fr;
    }
  }
  .quote__price {
    border-bottom: 1px dashed var(--line);
    padding-bottom: 1.25rem;
  }
  @media (min-width: 820px) {
    .quote__price {
      border-bottom: 0;
      border-right: 1px dashed var(--line);
      padding: 0 2rem 0 0;
    }
  }
  .quote__note {
    color: var(--muted);
    margin: 0.5rem 0 1.2rem;
  }
  .quote__title {
    font-size: var(--step-1);
  }
</style>
