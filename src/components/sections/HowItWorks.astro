---
import SectionHead from '../ui/SectionHead.astro';
interface Props {
  title?: string;
  lede?: string;
}
const {
  title = 'How it works',
  lede = 'Four steps from picking a spot to seeing your ad out in the neighbourhood.',
} = Astro.props;
const steps = [
  { t: 'Pick your spot.', d: 'Choose an open sign placement or mailer, or tell us the neighbourhood you want to reach.' },
  { t: 'Confirm and book.', d: 'We confirm your category and send a short quote. Your spot is booked once you accept.' },
  { t: 'Approve your ad.', d: 'Send your artwork, or your logo and a few lines and we’ll design it for you.' },
  { t: 'See it out in the neighbourhood.', d: 'We print and place your sign panel or mail your campaign, and send you confirmation.' },
];
---
<section class="section section--paper" aria-labelledby="how-title">
  <div class="container">
    <SectionHead eyebrow="The process" title={title} lede={lede} id="how-title" />
    <ol class="steps">
      {
        steps.map((s, i) => (
          <li class="step">
            <span class="step__num" aria-hidden="true">{i + 1}</span>
            <h3 class="step__title">{s.t}</h3>
            <p>{s.d}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    counter-reset: step;
  }
  .step {
    position: relative;
    padding: 1.5rem 1.4rem 1.4rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--ivory);
  }
  .step::after {
    content: '';
    position: absolute;
    inset: auto 1.4rem 0;
    border-bottom: 3px solid var(--mustard);
    border-radius: 3px;
  }
  .step:nth-child(2)::after {
    border-color: var(--brick);
  }
  .step:nth-child(3)::after {
    border-color: var(--navy-2);
  }
  .step:nth-child(4)::after {
    border-color: #9aa7bd;
  }
  .step__num {
    display: inline-grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    background: var(--navy);
    color: var(--paper);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.15rem;
    margin-bottom: 1rem;
  }
  .step__title {
    font-size: var(--step-1);
  }
  .step p {
    color: var(--muted);
    margin: 0;
    font-size: 0.97rem;
  }
</style>
