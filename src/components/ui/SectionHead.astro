---
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  center?: boolean;
  as?: 'h1' | 'h2';
  id?: string;
}
const { eyebrow, title, lede, center = false, as: Tag = 'h2', id } = Astro.props;
---
<div class:list={['section-head', { 'section-head--center': center }]}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <Tag id={id}>{title}</Tag>
  {lede && <p class="lede">{lede}</p>}
  <slot />
</div>
