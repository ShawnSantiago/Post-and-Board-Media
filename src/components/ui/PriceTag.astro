---
/**
 * Price display. Exact opportunity prices win; otherwise a format's "from"
 * anchor; otherwise "Ask for current rates". Monthly equivalents always show
 * the upfront payment and commitment beside them.
 */
import type { PriceRecord } from '../../content/pricing';
import { formatCad } from '../../lib/format';

interface Props {
  /** Exact price for a specific opportunity. */
  exact?: { amountCad: number; basis: string; notes?: string } | null;
  /** Format-level "from" anchor. */
  anchor?: PriceRecord | null;
  size?: 'sm' | 'lg';
}
const { exact, anchor, size = 'sm' } = Astro.props;
---
<div class:list={['price-tag', `price-tag--${size}`]}>
  {
    exact ? (
      <>
        <p class="price-tag__amount">
          {formatCad(exact.amountCad)} <span>{exact.basis}</span>
        </p>
        {exact.notes && <p class="price-tag__detail">{exact.notes}</p>}
      </>
    ) : anchor?.fromCad != null ? (
      <>
        <p class="price-tag__amount">
          <span>From</span> {formatCad(anchor.fromCad)} <span>{anchor.basis}</span>
        </p>
        {anchor.monthlyEquivalentCad != null && anchor.upfrontCad != null && (
          <p class="price-tag__detail">
            Equivalent to {formatCad(anchor.monthlyEquivalentCad)}/month · Paid upfront: {formatCad(anchor.upfrontCad)}
            {anchor.commitment && ` · ${anchor.commitment}`}
          </p>
        )}
        {anchor.note && <p class="price-tag__detail">{anchor.note}</p>}
      </>
    ) : (
      <p class="price-tag__amount">Ask for current rates</p>
    )
  }
</div>

<style>
  .price-tag__amount {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 600;
    color: var(--navy);
    margin: 0;
  }
  .price-tag--lg .price-tag__amount {
    font-size: var(--step-3);
  }
  .price-tag__amount span {
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--muted);
  }
  .price-tag__detail {
    font-size: 0.9rem;
    color: var(--muted);
    margin: 0.2rem 0 0;
  }
</style>
