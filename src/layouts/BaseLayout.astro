---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/inter';
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Breadcrumbs, { type Crumb } from '../components/layout/Breadcrumbs.astro';
import { site } from '../config/site';
import { absoluteUrl, isPreview, siteOrigin } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  /** Pages that must never be indexed (drafts, thank-you, examples). */
  noindex?: boolean;
  breadcrumbs?: Crumb[];
  jsonLd?: Record<string, unknown>[];
}

const { title, description, noindex = false, breadcrumbs, jsonLd = [] } = Astro.props;
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const robotsNoindex = noindex || isPreview;
const canonical = !robotsNoindex ? absoluteUrl(path) : null;

const structured: Record<string, unknown>[] = [...jsonLd];
if (breadcrumbs && siteOrigin) {
  structured.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [{ label: 'Home', href: '/' }, ...breadcrumbs].map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.label,
      item: absoluteUrl(c.href ?? path),
    })),
  });
}
---
<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {robotsNoindex && <meta name="robots" content="noindex, follow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#1e3a2d" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="en_CA" />
    {canonical && <meta property="og:url" content={canonical} />}
    {structured.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      {
        breadcrumbs && (
          <div class="container crumbs-wrap">
            <Breadcrumbs items={breadcrumbs} />
          </div>
        )
      }
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
  .crumbs-wrap {
    padding-top: 1.5rem;
  }
</style>
