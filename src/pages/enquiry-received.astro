---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Enquiry sent | Post and Board Media" description="Your enquiry has been sent." noindex>
  <section class="section">
    <div class="container--narrow">
      <div class="notice notice--success">
        <strong>Thanks — your enquiry has been sent.</strong>
      </div>
      <h1 style="margin-top:1.5rem">What happens next</h1>
      <p class="lede">
        We’ll review your details and reply by email. Nothing is booked yet — any placement, campaign or hosting
        arrangement is confirmed only in writing.
      </p>
      <div class="btn-row">
        <a class="btn btn--primary" href="/opportunities">Browse opportunities</a>
        <a class="btn btn--ghost" href="/">Back to home</a>
      </div>
    </div>
  </section>
</BaseLayout>
