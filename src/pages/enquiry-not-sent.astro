---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Enquiry not sent | Post and Board Media" description="Your enquiry could not be sent." noindex>
  <section class="section">
    <div class="container--narrow">
      <div class="notice notice--error" role="alert">
        <strong>Your enquiry was not sent.</strong>
        <span data-reason>Something went wrong. Please try again.</span>
      </div>
      <h1 style="margin-top:1.5rem">Sorry about that</h1>
      <p class="lede">Your message didn’t go through. Please go back and try again in a moment.</p>
      <div class="btn-row">
        <a class="btn btn--primary" href="/contact" data-back>Back to the form</a>
        <a class="btn btn--ghost" href="/">Home</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const params = new URLSearchParams(location.search);
  const reasons: Record<string, string> = {
    invalid: 'Some required details were missing or invalid.',
    not_configured: 'Something went wrong on our side.',
    delivery: 'Something went wrong on our side.',
  };
  const reason = params.get('reason');
  const el = document.querySelector('[data-reason]');
  if (el && reason && reasons[reason]) el.textContent = reasons[reason];
  const back = params.get('back');
  const link = document.querySelector<HTMLAnchorElement>('[data-back]');
  if (link && (back === '/contact' || back === '/host-a-sign')) link.href = back;
</script>
