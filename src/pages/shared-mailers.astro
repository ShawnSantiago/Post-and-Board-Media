---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostcardMockup from '../components/mockups/PostcardMockup.astro';
import MailerBackMockup from '../components/mockups/MailerBackMockup.astro';
import ExampleFigure from '../components/mockups/ExampleFigure.astro';
import Photo from '../components/ui/Photo.astro';
import mailerDoor from '../assets/images/mailer-at-door.webp';
import mailerDesk from '../assets/images/mailer-business-desk.webp';
import SectionHead from '../components/ui/SectionHead.astro';
import FaqList from '../components/ui/FaqList.astro';
import HowItWorks from '../components/sections/HowItWorks.astro';
import QuoteIncludes from '../components/sections/QuoteIncludes.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import { faqsFor } from '../content/faqs';
import { pricing } from '../content/pricing';
import { site } from '../config/site';

const specs = [
  ['Distribution area', 'The exact area the campaign covers.'],
  ['Recipient type', 'Households or business addresses.'],
  ['Quantity', 'How many homes or businesses it reaches.'],
  ['Your ad space', 'Position, size and which side of the mailer.'],
  ['Artwork deadline', 'When your artwork or content must be approved.'],
  ['Mailing date', 'When the mailer goes out.'],
  ['Open categories', 'Which business categories still have a spot.'],
];
---
<BaseLayout
  title="Shared Mailers in Hamilton | Neighbourhood Postcard Advertising | Post and Board Media"
  description="Book one spot on a shared postcard mailed to Hamilton homes or businesses. Share printing and distribution costs with other local advertisers — we organize the rest."
  breadcrumbs={[{ label: 'Shared mailers' }]}
>
  <section class="section--tight page-hero">
    <div class="container grid-2">
      <div>
        <p class="eyebrow">Delivered to a defined area</p>
        <h1>Shared mailers for local businesses</h1>
        <p class="lede">
          Several businesses share one printed mailer and the campaign costs. Each advertiser buys a defined space in a
          campaign we organize.
        </p>
        <p class="pull">Join a campaign — not organize an entire mailing yourself.</p>
        <div class="btn-row">
          <a class="btn btn--primary" href="/opportunities?format=mailer">View upcoming mailers</a>
          <a class="btn btn--ghost" href="/contact?format=mailer">Ask about a mailer</a>
        </div>
      </div>
      <ExampleFigure caption="Front of a shared postcard with six separate advertisers.">
        <PostcardMockup highlight={2} />
      </ExampleFigure>
    </div>
  </section>

  <section class="section section--paper" aria-labelledby="model-title">
    <div class="container">
      <SectionHead eyebrow="The model" title="We organize the campaign. You choose your space." id="model-title"
        lede="You don’t have to recruit the other advertisers, find a printer or arrange distribution. We plan each campaign, bring non-competing businesses together and coordinate everything through one contact." />
      <div class="model">
        <div class="model__col">
          <h3>What we do</h3>
          <ul class="checklist">
            <li>Plan the campaign’s area, recipient type and timing</li>
            <li>Bring the advertisers together</li>
            <li>Coordinate artwork and approvals</li>
            <li>Arrange printing and distribution through appropriate providers</li>
          </ul>
        </div>
        <div class="model__col">
          <h3>What you do</h3>
          <ul class="checklist">
            <li>Tell us where and who you want to reach</li>
            <li>Choose a space in a suitable campaign</li>
            <li>Send artwork, or your logo and text</li>
            <li>Approve your ad before it prints</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="aud-title">
    <div class="container">
      <SectionHead eyebrow="Two kinds of campaign" title="Households or businesses — kept separate" id="aud-title"
        lede="Household and business-address campaigns reach different people, so each is its own campaign with its own reach." />
      <div class="aud">
        <article class="aud__card">
          <Photo
            class="aud__photo"
            src={mailerDoor}
            alt="Hands holding a shared postcard beside a front-door mail slot."
            illustrative
            ratio="3 / 2"
            sizes="(min-width: 760px) 560px, 100vw"
          />
          <span class="chip chip--brick">Household campaigns</span>
          <h3>For businesses that serve people near home</h3>
          <p>Delivered to residential addresses in a defined neighbourhood or area. A fit for restaurants, trades, clinics, fitness studios, home services and other neighbourhood businesses.</p>
        </article>
        <article class="aud__card aud__card--biz">
          <Photo
            class="aud__photo"
            src={mailerDesk}
            alt="A shared postcard and other mail on a business reception counter."
            illustrative
            ratio="3 / 2"
            sizes="(min-width: 760px) 560px, 100vw"
          />
          <span class="chip">Business-address campaigns</span>
          <h3>For businesses that sell to other businesses</h3>
          <p>Delivered to commercial addresses, such as a business district or industrial area. A fit for cleaning, catering, IT, printing, signage, bookkeeping and other B2B services.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section section--cream" aria-labelledby="specs-title">
    <div class="container grid-2">
      <div>
        <SectionHead eyebrow="Every campaign lists" title="See exactly who you’ll reach" id="specs-title"
          lede="Each mailer listing shows these details up front, so you can pick the right one." />
        <div class="notes">
          <p><strong>One business per category</strong> on each mailer, so your ad isn’t next to a competitor’s.</p>
          <p><strong>We handle it all</strong> — design help, printing and distribution.</p>
        </div>
      </div>
      <dl class="spec-list">
        {specs.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
    </div>
  </section>

  <section class="section" aria-labelledby="frontback-title">
    <div class="container">
      <SectionHead eyebrow="Front and back" title="Every ad gets its own clear space" id="frontback-title" center
        lede="A good shared mailer is easy to scan. Each advertiser has a defined, separated panel with room for a name, an offer and a way to get in touch." />
      <div class="frontback">
        <ExampleFigure caption="Front"><PostcardMockup /></ExampleFigure>
        <ExampleFigure caption="Back"><MailerBackMockup /></ExampleFigure>
      </div>
    </div>
  </section>

  <section class="section--tight">
    <div class="container">
      <QuoteIncludes price={pricing.mailer} cta={{ href: '/opportunities?format=mailer', label: 'View upcoming mailers' }} />
    </div>
  </section>

  <HowItWorks title="From enquiry to mailbox" />

  <section class="section section--paper" aria-labelledby="mailer-faq">
    <div class="container--narrow">
      <h2 id="mailer-faq">Shared mailer questions</h2>
      <FaqList items={faqsFor('mailers', site.features.digitalScreensInterest)} />
    </div>
  </section>

  <CtaBand
    title="Reach thousands of local homes for the price of one spot."
    text="Browse upcoming Hamilton mailers, or tell us the neighbourhood you want to reach."
    primary={{ href: '/opportunities?format=mailer', label: 'View upcoming mailers' }}
    secondary={{ href: '/storefront-signs', label: 'Storefront signs' }}
  />
</BaseLayout>

<style>
  .page-hero {
    padding-top: 1rem;
  }
  .pull {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-2);
    color: var(--navy);
    border-left: 4px solid var(--brick);
    padding-left: 1rem;
    margin: 1.5rem 0 1.8rem;
    line-height: 1.25;
  }
  .model {
    display: grid;
    gap: 1.25rem;
  }
  @media (min-width: 760px) {
    .model {
      grid-template-columns: 1fr 1fr;
    }
  }
  .model__col {
    background: var(--ivory);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.6rem;
  }
  .model__col h3 {
    font-size: var(--step-1);
  }
  .aud {
    display: grid;
    gap: 1.25rem;
  }
  @media (min-width: 760px) {
    .aud {
      grid-template-columns: 1fr 1fr;
    }
  }
  .aud__card {
    padding: 1.8rem;
    border-radius: var(--radius);
    background: #f4ddd5;
  }
  .aud__card--biz {
    background: var(--mist);
  }
  .aud__card .chip {
    background: var(--paper);
  }
  .aud__card :global(.aud__photo) {
    margin-bottom: 1.25rem;
  }
  .aud__card h3 {
    font-size: var(--step-2);
    margin-top: 1rem;
  }
  .aud__card p {
    margin: 0;
  }
  .notes p {
    padding: 1rem 1.1rem;
    background: var(--paper);
    border-radius: var(--radius-sm);
    border: 1px solid var(--line);
    font-size: 0.97rem;
  }
  .frontback {
    display: grid;
    gap: 2.5rem 2rem;
  }
  @media (min-width: 860px) {
    .frontback {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
