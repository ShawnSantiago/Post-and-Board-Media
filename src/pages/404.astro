---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found | Post and Board Media" description="This page doesn’t exist." noindex>
  <section class="section">
    <div class="container--narrow">
      <p class="eyebrow">404</p>
      <h1>We couldn’t find that page.</h1>
      <p class="lede">It may have moved, or the opportunity may no longer be listed.</p>
      <div class="btn-row">
        <a class="btn btn--primary" href="/">Home</a>
        <a class="btn btn--ghost" href="/opportunities">Opportunities</a>
        <a class="btn btn--ghost" href="/contact">Check availability</a>
      </div>
    </div>
  </section>
</BaseLayout>
