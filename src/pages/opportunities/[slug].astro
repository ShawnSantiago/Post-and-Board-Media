---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EnquiryForm from '../../components/forms/EnquiryForm.astro';
import PriceTag from '../../components/ui/PriceTag.astro';
import { opportunities, isEnquirable } from '../../lib/opportunities';
import { audienceLabels, opportunityStatusLabels, type Opportunity } from '../../content/opportunities';
import { getArea } from '../../content/areas';
import { formatLabels } from '../../content/services';
import { formatDate, formatNumber } from '../../lib/format';
import { pricing } from '../../content/pricing';

export function getStaticPaths() {
  // Only records present in the loaded dataset get a page. In production that
  // means approved records from src/content/opportunities.ts only.
  return opportunities.map((o) => ({ params: { slug: o.slug }, props: { opp: o } }));
}

interface Props {
  opp: Opportunity;
}
const { opp } = Astro.props;
const area = getArea(opp.area);
const enquirable = isEnquirable(opp);

const isSign = opp.format === 'board';
const hasSpots = opp.spotsTotal != null && opp.spotsBooked != null;
const rows: [string, string | undefined][] = [
  ['Format', [formatLabels[opp.format], opp.specs].filter(Boolean).join(' · ')],
  ['Area', `${opp.locality ? `${opp.locality}, ` : ''}${area?.name ?? opp.area}`],
  ['Host business', opp.venueName],
  ['Location', opp.location],
  ['Sign is out', opp.displayHours],
  ['Audience', opp.audience ? audienceLabels[opp.audience] : undefined],
  [opp.audience === 'business' ? 'Businesses reached' : 'Households reached', opp.quantity != null ? formatNumber(opp.quantity) : undefined],
  [isSign ? 'Term' : 'Mailing', opp.term],
  ['Your ad space', opp.adSpace],
  ['Artwork deadline', opp.artworkDeadline],
  ['Artwork help', opp.artworkHelp],
  ['Sign goes out', opp.installationWindow],
  ['Category rules', opp.categoryRules],
  ['Needed to go ahead', opp.participationRequirements],
  ['If the location changes', opp.ifUnavailable],
  ['Spots', hasSpots ? `${opp.spotsBooked} of ${opp.spotsTotal} booked` : undefined],
  ['Updated', formatDate(opp.lastUpdated)],
];
---
<BaseLayout
  title={`${opp.title} | ${area?.name ?? ''} ${formatLabels[opp.format]} | Post and Board Media`}
  description={opp.summary}
  noindex={opp.isExample}
  breadcrumbs={[{ label: 'Opportunities', href: '/opportunities' }, { label: opp.title }]}
>
  <section class="section--tight">
    <div class="container detail">
      <div>
        {
          opp.isExample && (
            <div class="notice notice--warn" style="margin-bottom:1.25rem">
              <strong>Example only — not a real opportunity.</strong>
              This fictional listing previews the layout. It can’t be enquired about and never appears in production.
            </div>
          )
        }
        <div class="chips">
          <span class="chip">{formatLabels[opp.format]}</span>
          {opp.audience && <span class="chip chip--brick">{audienceLabels[opp.audience]}</span>}
          <span class="chip chip--dot chip--mustard">{opportunityStatusLabels[opp.status]}</span>
        </div>
        <h1>{opp.title}</h1>
        <p class="lede">{opp.summary}</p>

        <h2 class="detail__h2">{isSign ? 'Placement details' : 'Campaign details'}</h2>
        <dl class="spec-list">
          {rows.filter(([, v]) => v).map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
        </dl>

        {
          opp.categories && opp.categories.length > 0 && (
            <>
              <h2 class="detail__h2">Categories</h2>
              <table class="cats">
                <thead>
                  <tr><th scope="col">Category</th><th scope="col">Status</th></tr>
                </thead>
                <tbody>
                  {opp.categories.map((c) => (
                    <tr>
                      <td>{c.name}</td>
                      <td>
                        <span class:list={['chip', 'chip--dot', c.status === 'filled' ? 'chip--muted' : '']}>
                          {c.status === 'filled' ? 'Filled' : 'Open'}
                        </span>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </>
          )
        }

        <div class="card price-card">
          <PriceTag exact={opp.price} anchor={pricing[opp.format]} size="lg" />
        </div>
      </div>

      <aside class="detail__aside">
        {
          opp.isExample ? (
            <div class="card">
              <h2 class="detail__h2">Enquiries</h2>
              <p>This is an example listing, so enquiries are disabled.</p>
              <a class="btn btn--ghost" href="/contact">Send a general enquiry</a>
            </div>
          ) : enquirable ? (
            <EnquiryForm
              title="Request this spot"
              intro="Tell us a little about your business. We’ll confirm your category is open and send a quote to book it."
              opportunity={{ slug: opp.slug, title: opp.title, area: opp.area, format: opp.format }}
              area={opp.area}
              format={opp.format}
            />
          ) : (
            <div class="card">
              <h2 class="detail__h2">{opportunityStatusLabels[opp.status]}</h2>
              <p>This opportunity isn’t taking enquiries. Tell us what you’re looking for and we’ll let you know about similar placements.</p>
              <a class="btn btn--primary" href={`/contact?area=${opp.area}&format=${opp.format}`}>Ask about similar opportunities</a>
            </div>
          )
        }
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .detail {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 980px) {
    .detail {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
    .detail__aside {
      position: sticky;
      top: 6rem;
    }
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1rem;
  }
  .detail__h2 {
    font-size: var(--step-2);
    margin-top: 2rem;
  }
  .detail__aside .detail__h2 {
    margin-top: 0;
  }
  .price-card {
    margin-top: 2rem;
  }
  .cats {
    width: 100%;
    border-collapse: collapse;
  }
  .cats th,
  .cats td {
    text-align: left;
    padding: 0.65rem 0.25rem;
    border-bottom: 1px solid var(--line);
  }
  .cats th {
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
  }
</style>
