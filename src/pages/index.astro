---
import BaseLayout from '../layouts/BaseLayout.astro';
import BoardMockup from '../components/mockups/BoardMockup.astro';
import PostcardMockup from '../components/mockups/PostcardMockup.astro';
import ExampleFigure from '../components/mockups/ExampleFigure.astro';
import SectionHead from '../components/ui/SectionHead.astro';
import HowItWorks from '../components/sections/HowItWorks.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import DigitalInterest from '../components/sections/DigitalInterest.astro';
import FaqList from '../components/ui/FaqList.astro';
import OpportunityCard from '../components/opportunities/OpportunityCard.astro';
import LaunchState from '../components/opportunities/LaunchState.astro';
import PriceTag from '../components/ui/PriceTag.astro';
import { pricing } from '../content/pricing';
import { site } from '../config/site';
import { services } from '../content/services';
import { faqsFor } from '../content/faqs';
import { opportunities } from '../lib/opportunities';
import { absoluteUrl, siteOrigin } from '../lib/seo';
import { getArea } from '../content/areas';

const featured = opportunities
  .filter((o) => o.status === 'accepting-enquiries' || o.status === 'open-for-applications')
  .slice(0, 3);
const hamilton = getArea('hamilton');
const streets = ['Locke Street South', 'James Street North', 'Ottawa Street North', 'Westdale Village', 'Concession Street', 'King Street West, Dundas', 'Wilson Street, Ancaster'];
const homeFaqs = faqsFor('home', site.features.digitalScreensInterest);

const orgLd: Record<string, unknown>[] = siteOrigin
  ? [
      {
        '@context': 'https://schema.org',
        '@type': 'Organization',
        name: site.name,
        slogan: site.tagline,
        url: absoluteUrl('/'),
        logo: absoluteUrl('/favicon.svg'),
        description: site.description,
        ...(site.contact.email ? { email: site.contact.email } : {}),
        ...(site.contact.phone ? { telephone: site.contact.phone } : {}),
        areaServed: { '@type': 'City', name: 'Hamilton, Ontario' },
      },
      { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: absoluteUrl('/') },
    ]
  : [];
---
<BaseLayout
  title="Post and Board Media | Storefront Sign & Shared Mailer Advertising in Hamilton"
  description="Shared local advertising without paying for the whole campaign. Advertise on storefront signs or share the cost of a neighbourhood mailer with other Hamilton businesses."
  jsonLd={orgLd}
>
  <!-- HERO -->
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="eyebrow">{site.tagline}</p>
        <h1>Shared local advertising without paying for the whole campaign.</h1>
        <p class="lede">
          Advertise on storefront signs or share the cost of a neighbourhood mailer with other local businesses.
        </p>
        <div class="btn-row">
          <a class="btn btn--primary" href="/opportunities">View available opportunities</a>
          <a class="btn btn--ghost" href="/host-a-sign">Host a sign</a>
        </div>
        <p class="hero__geo">
          <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12z" fill="none" stroke="currentColor" stroke-width="2"></path><circle cx="12" cy="10" r="2.5" fill="currentColor"></circle></svg>
          {site.launchLine}
        </p>
      </div>
      <div class="hero__visual">
        <ExampleFigure class="hero__figure">
          <div class="hero__stack">
            <div class="hero__board"><BoardMockup /></div>
            <div class="hero__card"><PostcardMockup /></div>
          </div>
        </ExampleFigure>
        <ul class="hero__legend" aria-label="What the example shows">
          <li><span class="dot dot--navy"></span>Sign outside a local business</li>
          <li><span class="dot dot--brick"></span>Shared neighbourhood mailer</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- PRODUCTS -->
  <section class="section" id="options" aria-labelledby="options-title">
    <div class="container">
      <SectionHead eyebrow="Two ways to advertise" title="Pick a spot. Share the cost." id="options-title"
        lede="We organize the sign or the mailer and divide it into affordable spots for local businesses." />
      <div class="options">
        <article class="option">
          <div class="option__visual option__visual--board">
            <ExampleFigure><BoardMockup highlight={1} /></ExampleFigure>
          </div>
          <div class="option__body">
            <p class="eyebrow">{services.boards.eyebrow}</p>
            <h3>{services.boards.title}</h3>
            <p>Reach people walking, shopping and spending time in local neighbourhoods — on the sidewalk signs storefronts put out every day.</p>
            <PriceTag anchor={pricing.board} />
            <div class="btn-row option__ctas">
              <a class="btn btn--primary btn--sm" href="/opportunities?format=board">View sign placements</a>
              <a class="text-link" href={services.boards.href}>How signs work</a>
            </div>
          </div>
        </article>
        <article class="option">
          <div class="option__visual option__visual--mailer">
            <ExampleFigure><PostcardMockup highlight={4} /></ExampleFigure>
          </div>
          <div class="option__body">
            <p class="eyebrow">{services.mailers.eyebrow}</p>
            <h3>{services.mailers.title}</h3>
            <p>Reach thousands of local homes or businesses while sharing printing and distribution costs with other advertisers.</p>
            <PriceTag anchor={pricing.mailer} />
            <div class="btn-row option__ctas">
              <a class="btn btn--primary btn--sm" href="/opportunities?format=mailer">View upcoming mailers</a>
              <a class="text-link" href={services.mailers.href}>How mailers work</a>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- OPPORTUNITIES -->
  <section class="section section--paper" aria-labelledby="opps-title">
    <div class="container">
      <div class="opps-head">
        <SectionHead eyebrow="Opportunities" title="Available now" id="opps-title" />
        {featured.length > 0 && <a class="text-link" href="/opportunities">See all opportunities</a>}
      </div>
      {
        featured.length > 0 ? (
          <div class="opp-grid">
            {featured.map((o) => (
              <OpportunityCard opp={o} />
            ))}
          </div>
        ) : (
          <LaunchState headingLevel="h3" />
        )
      }
    </div>
  </section>

  <HowItWorks />

  <!-- WHY SHARED -->
  <section class="section section--cream" aria-labelledby="why-title">
    <div class="container grid-2 grid-2--wide-left">
      <div>
        <SectionHead eyebrow="Why shared advertising" title="Neighbourhood reach at a small-business price" id="why-title" />
        <ul class="why">
          <li>
            <h3>Split the cost</h3>
            <p>Several local businesses share one sign or mailer, so you pay for your spot — not the whole campaign.</p>
          </li>
          <li>
            <h3>Choose where</h3>
            <p>Every sign is on a specific street and every mailer covers a defined area.</p>
          </li>
          <li>
            <h3>One category per spot</h3>
            <p>Campaigns are organized by category, so you’re not squeezed in beside a competitor.</p>
          </li>
          <li>
            <h3>We do the legwork</h3>
            <p>Hosts, printing, distribution and artwork — handled through one contact.</p>
          </li>
        </ul>
      </div>
      <ExampleFigure caption="Every advertiser gets a clean, clearly separated space.">
        <PostcardMockup variant="business" />
      </ExampleFigure>
    </div>
  </section>

  <!-- HOST -->
  <section class="section section--navy" aria-labelledby="host-title">
    <div class="container grid-2">
      <div class="host__visual">
        <ExampleFigure><BoardMockup /></ExampleFigure>
      </div>
      <div>
        <p class="eyebrow">For storefront businesses</p>
        <h2 id="host-title">Get a professional sidewalk sign for your business.</h2>
        <p class="lede">Promote your own specials while local sponsors help cover the cost of the sign.</p>
        <ul class="checklist">
          <li>Most of the sign is yours — specials, menus, events, sales.</li>
          <li>Little or no upfront cost.</li>
          <li>We handle sponsors, artwork and printing.</li>
        </ul>
        <div class="btn-row" style="margin-top:1.75rem">
          <a class="btn btn--accent" href="/host-a-sign">Host a sign</a>
        </div>
      </div>
    </div>
  </section>

  <!-- HAMILTON -->
  <section class="section" aria-labelledby="areas-title">
    <div class="container grid-2 grid-2--wide-left">
      <div>
        <SectionHead eyebrow="Launching in Hamilton" title="Built street by street in Hamilton" id="areas-title"
          lede="We’re starting in Hamilton — on the walkable streets where sidewalk signs get seen and in the neighbourhoods mailers reach." />
        <a class="btn btn--primary" href="/areas/hamilton">Advertising in Hamilton</a>
      </div>
      <div>
        <ul class="streets" aria-label="Hamilton streets we’re focused on">
          {streets.map((st) => <li>{st}</li>)}
        </ul>
        {hamilton?.communities && (
          <p class="communities">
            Also: {hamilton.communities.items.map((c, i) => (
              <>{i > 0 && ', '}<a href={`/areas/hamilton#${c.slug}`}>{c.name}</a></>
            ))}
          </p>
        )}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section--paper" aria-labelledby="faq-title">
    <div class="container faq-wrap">
      <SectionHead eyebrow="Questions" title="Good to know" id="faq-title" />
      <div>
        <FaqList items={homeFaqs} />
        <div style="margin-top:2.5rem"><DigitalInterest /></div>
      </div>
    </div>
  </section>

  <CtaBand
    title="Tell us where you’d like to advertise."
    text="Pick an open spot, or tell us your neighbourhood and category and we’ll find you one."
    primary={{ href: '/opportunities', label: 'View opportunities' }}
    secondary={{ href: '/contact', label: 'Get in touch' }}
  />
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(3rem, 7vw, 5.5rem);
    background:
      radial-gradient(circle at 85% 20%, rgba(233, 185, 73, 0.2), transparent 40%),
      linear-gradient(var(--ivory), var(--ivory));
    overflow: hidden;
  }
  .hero__grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: center;
  }
  @media (min-width: 960px) {
    .hero__grid {
      grid-template-columns: 1.02fr 1fr;
    }
  }
  .hero h1 {
    font-size: clamp(2.2rem, 1.5rem + 2.6vw, 3.5rem);
    max-width: 18ch;
  }
  .hero .lede {
    margin-bottom: 1.8rem;
  }
  .hero__geo {
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
    margin-top: 1.6rem;
    font-size: 0.95rem;
    color: var(--muted);
  }
  .hero__geo svg {
    flex: none;
    color: var(--brick-deep);
    margin-top: 0.15rem;
  }
  .hero__stack {
    position: relative;
    padding-bottom: 14%;
  }
  .hero__board {
    width: 64%;
    transform: rotate(-1.5deg);
  }
  .hero__card {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 68%;
    transform: rotate(2.5deg);
  }
  .hero__legend {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
    padding: 0;
    margin: 1.5rem 0 0;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .hero__legend li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .dot {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 3px;
  }
  .dot--navy {
    background: var(--navy);
  }
  .dot--brick {
    background: var(--brick);
  }

  .options {
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 900px) {
    .options {
      grid-template-columns: 1fr 1fr;
    }
  }
  .option {
    display: flex;
    flex-direction: column;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) + 6px);
    overflow: hidden;
    box-shadow: var(--shadow);
  }
  .option__visual {
    padding: 2.5rem 2rem 2rem;
    display: grid;
    place-items: center;
    min-height: 330px;
  }
  .option__visual--board {
    background: var(--mist);
  }
  .option__visual--board :global(figure) {
    width: min(62%, 260px);
  }
  .option__visual--mailer {
    background: #f4ddd5;
  }
  .option__visual--mailer :global(figure) {
    width: 100%;
  }
  .option__body {
    padding: clamp(1.4rem, 3vw, 2rem);
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    flex: 1;
  }
  .option__body .checklist {
    margin: 0.5rem 0 1.4rem;
  }
  .option__body :global(.price-tag) {
    margin-top: auto;
  }
  .option__ctas {
    margin-top: 1rem;
  }
  .opps-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0 1rem;
    margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
  }
  .opps-head :global(.section-head) {
    margin-bottom: 0;
  }
  .streets {
    list-style: none;
    padding: 0;
    margin: 0 0 1.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .streets li {
    padding: 0.5rem 1rem;
    border-radius: 999px;
    background: var(--paper);
    border: 1px solid var(--line);
    font-weight: 500;
  }
  .communities {
    color: var(--muted);
  }

  .opp-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
  }
  .more-link {
    margin-top: 1.5rem;
  }

  .why {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1.25rem;
  }
  @media (min-width: 640px) {
    .why {
      grid-template-columns: 1fr 1fr;
    }
  }
  .why li {
    border-top: 3px solid var(--navy);
    padding-top: 0.9rem;
  }
  .why h3 {
    font-size: var(--step-1);
    margin-bottom: 0.4rem;
  }
  .why p {
    color: var(--muted);
    margin: 0;
    font-size: 0.97rem;
  }

  .host__visual {
    max-width: 380px;
    margin-inline: auto;
    width: 100%;
  }

  .faq-wrap {
    display: grid;
    gap: 1rem 4rem;
  }
  @media (min-width: 900px) {
    .faq-wrap {
      grid-template-columns: 0.8fr 1.4fr;
      align-items: start;
    }
  }
</style>
