---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import Photo from '../components/ui/Photo.astro';
import aboutDesk from '../assets/images/about-desk.webp';
import { site } from '../config/site';
---
<BaseLayout
  title="About Post and Board Media | Hamilton Local Advertising"
  description="Post and Board Media is a Hamilton-based local advertising company run by Shawn Santiago, organizing shared neighbourhood mailers and sponsored storefront signs for small businesses."
  breadcrumbs={[{ label: 'About' }]}
>
  <section class="section--tight">
    <div class="container about">
      <div>
        <p class="eyebrow">About</p>
        <h1>Local advertising that small businesses can share.</h1>
        <p class="lede">{site.description}</p>
      </div>
      <Photo
        class="about__photo"
        src={aboutDesk}
        alt="A desk with postcard layout proofs, colour swatches, a ruler and a cup of tea, with a hand sketching on a proof."
        loading="eager"
      />
    </div>
  </section>

  <section class="section section--paper">
    <div class="container--narrow prose">
      <h2>What we do</h2>
      <p>
        We create local advertising space — a sign outside a storefront, a postcard to a neighbourhood — and divide it into
        affordable spots for local businesses. You get neighbourhood reach without paying for, or organizing, a whole
        campaign.
      </p>
      <ul class="checklist">
        <li><a href="/storefront-signs">Storefront signs</a>: sponsor panels on the sidewalk signs local businesses put out every day.</li>
        <li><a href="/shared-mailers">Shared mailers</a>: one spot on a postcard to local homes or businesses.</li>
      </ul>

      <h2>How we work</h2>
      <ul class="checklist">
        <li>One contact from booking to launch — you deal with {site.owner} directly.</li>
        <li>Clear listings: every sign and mailer shows its location, reach and open categories.</li>
        <li>We handle hosts, design help, printing and distribution.</li>
      </ul>

      <h2>Starting in Hamilton</h2>
      <p>
        We’re building our network street by street in <a href="/areas/hamilton">Hamilton</a> before expanding to nearby
        cities.
      </p>

      {
        site.parkdaleDigital.show && (
          <p class="aside">
            {site.parkdaleDigital.url ? <a href={site.parkdaleDigital.url}>{site.parkdaleDigital.text}</a> : site.parkdaleDigital.text}
          </p>
        )
      }
    </div>
  </section>

  <CtaBand
    title="Let’s get your business on the street."
    text="Browse open spots, or tell us your neighbourhood and we’ll find the right placement."
    primary={{ href: '/opportunities', label: 'View opportunities' }}
    secondary={{ href: '/host-a-sign', label: 'Host a sign' }}
  />
</BaseLayout>

<style>
  .about {
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  @media (min-width: 880px) {
    .about {
      grid-template-columns: 1.1fr 1fr;
    }
  }
  .about h1 {
    max-width: 18ch;
  }
  .aside {
    font-size: 0.95rem;
    color: var(--muted);
    border-top: 1px dashed var(--line);
    padding-top: 1rem;
    margin-top: 2rem;
  }
</style>
