---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import Photo from '../components/ui/Photo.astro';
import aboutDesk from '../assets/images/about-desk.webp';
import { site } from '../config/site';
---
<BaseLayout
  title="About Post and Board Media | Owner-Operated Local Advertising"
  description="Post and Board Media is an owner-operated business helping local businesses take part in organized advertising — shared mailers and boards inside local venues."
  breadcrumbs={[{ label: 'About' }]}
>
  <section class="section--tight">
    <div class="container about">
      <div>
        <p class="eyebrow">About</p>
        <h1>Real advertising in real places, organized by a real person.</h1>
        <p class="lede">
          Post and Board Media is an owner-operated business being developed by {site.owner}. The idea is practical:
          help local businesses take part in organized advertising without having to run a whole campaign themselves.
        </p>
      </div>
      <Photo
        class="about__photo"
        src={aboutDesk}
        alt="A desk with postcard layout proofs, colour swatches, a ruler and a cup of tea, with a hand sketching on a proof."
        loading="eager"
      />
    </div>
  </section>

  <section class="section section--paper">
    <div class="container--narrow prose">
      <h2>Why shared formats</h2>
      <p>
        Organizing a mailing or finding a spot inside a busy local venue takes time most small businesses don’t have.
        Shared formats spread that work — and the campaign costs — across several advertisers, while each business keeps
        its own clearly defined space.
      </p>
      <p>
        So we focus on two things: <a href="/advertising-boards">advertising boards</a> inside approved local businesses,
        and <a href="/shared-mailers">shared mailers</a> sent to a defined area. We’re not a full-service digital
        marketing agency, and we don’t try to be.
      </p>

      <h2>How we work</h2>
      <ul class="checklist">
        <li>Campaigns are organized by hand. You deal with a person, not a booking engine.</li>
        <li>Every placement and campaign is confirmed in a written quote before you commit.</li>
        <li>We say what’s confirmed and what isn’t — no invented availability, reach figures or promises of results.</li>
        <li>Printing and distribution are coordinated through appropriate providers.</li>
      </ul>

      <h2>Where we’re starting</h2>
      <p>
        {site.launchLine} See <a href="/areas">areas</a> for what’s happening where.
      </p>

      {
        site.parkdaleDigital.show && (
          <p class="aside">
            {site.parkdaleDigital.url ? <a href={site.parkdaleDigital.url}>{site.parkdaleDigital.text}</a> : site.parkdaleDigital.text}
          </p>
        )
      }
    </div>
  </section>

  <CtaBand
    title="Have a question before you enquire?"
    text="Send a short note with your area and what you have in mind. We’ll reply personally."
    primary={{ href: '/contact', label: 'Get in touch' }}
    secondary={{ href: '/host-a-board', label: 'Host a board' }}
  />
</BaseLayout>

<style>
  .about {
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  @media (min-width: 880px) {
    .about {
      grid-template-columns: 1.1fr 1fr;
    }
  }
  .about h1 {
    max-width: 18ch;
  }
  .aside {
    font-size: 0.95rem;
    color: var(--muted);
    border-top: 1px dashed var(--line);
    padding-top: 1rem;
    margin-top: 2rem;
  }
</style>
