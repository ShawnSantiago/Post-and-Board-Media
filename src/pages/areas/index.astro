---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AreaGrid from '../../components/sections/AreaGrid.astro';
import CtaBand from '../../components/sections/CtaBand.astro';
import { getArea } from '../../content/areas';
const hamilton = getArea('hamilton');
---
<BaseLayout
  title="Where We Advertise | Hamilton First | Post and Board Media"
  description="Post and Board Media is launching in Hamilton, with storefront signs and shared mailers across the city. Nearby cities follow once Hamilton is established."
  breadcrumbs={[{ label: 'Areas' }]}
>
  <section class="section--tight">
    <div class="container">
      <p class="eyebrow">Cities and communities</p>
      <h1>Starting in Hamilton</h1>
      <p class="lede">
        We’re building our network street by street in Hamilton first. Burlington, Oakville and other nearby cities come
        next — tell us if you’d like to be first when they open.
      </p>
    </div>
  </section>
  <section class="section" style="padding-top:1rem">
    <div class="container">
      <AreaGrid headingLevel="h2" />
      {
        hamilton?.communities && (
          <div class="communities">
            <h2>Communities within Hamilton</h2>
            <ul>
              {hamilton.communities.items.map((c) => (
                <li>
                  <a href={`/areas/hamilton#${c.slug}`}>{c.name}</a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </section>
  <CtaBand title="Want to be first in your city?" text="Tell us where you want to advertise and we’ll let you know when signs and mailers open there." primary={{ href: '/contact?area=other', label: 'Tell us your area' }} />
</BaseLayout>

<style>
  .communities {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 2px dashed var(--line);
  }
  .communities h2 {
    font-size: var(--step-2);
  }
  .communities ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .communities a {
    display: inline-block;
    padding: 0.45rem 1rem;
    border-radius: 999px;
    background: var(--paper);
    border: 1px solid var(--line);
    text-decoration: none;
    font-weight: 500;
  }
  .communities a:hover {
    border-color: var(--navy);
  }
</style>
