---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EnquiryForm from '../../components/forms/EnquiryForm.astro';
import FaqList from '../../components/ui/FaqList.astro';
import OpportunityCard from '../../components/opportunities/OpportunityCard.astro';
import { areas, getArea, statusLabels, type Area } from '../../content/areas';
import { opportunities } from '../../lib/opportunities';

export function getStaticPaths() {
  return areas.map((a) => ({ params: { slug: a.slug }, props: { area: a } }));
}
interface Props {
  area: Area;
}
const { area } = Astro.props;
const isDraft = area.readiness === 'draft';
const areaOpps = opportunities.filter((o) => o.area === area.slug);
const neighbours = area.neighbours.map((s) => getArea(s)).filter((a): a is Area => Boolean(a));
---
<BaseLayout
  title={area.seo.title}
  description={area.seo.description}
  noindex={isDraft}
  breadcrumbs={[{ label: 'Areas', href: '/areas' }, { label: area.name }]}
>
  <section class="section--tight area-hero">
    <div class="container">
      <p class="eyebrow">{area.region}</p>
      <h1>{area.h1}</h1>
      <p class="lede">{area.intro}</p>

      <div class="status card" aria-labelledby="status-title">
        <h2 id="status-title" class="status__title">Where things stand in {area.name}</h2>
        <div class="status__grid">
          <div>
            <p class="status__label">Advertising boards</p>
            <p class="chip chip--dot">{statusLabels[area.status.boards]}</p>
          </div>
          <div>
            <p class="status__label">Shared mailers</p>
            <p class="chip chip--dot chip--orange">{statusLabels[area.status.mailers]}</p>
          </div>
          <p class="status__summary">{area.status.summary}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:1rem" aria-labelledby="services-title">
    <div class="container">
      <h2 id="services-title">What you can enquire about in {area.name}</h2>
      <div class="svc">
        <a class="svc__card" href={`/contact?area=${area.slug}&format=board`}>
          <span class="eyebrow">Inside local businesses</span>
          <strong>Advertising boards</strong>
          <span>A placement on a board inside an approved {area.name} venue.</span>
          <span class="text-link">Ask about board placements</span>
        </a>
        <a class="svc__card svc__card--mailer" href={`/contact?area=${area.slug}&format=mailer`}>
          <span class="eyebrow">Delivered to a defined area</span>
          <strong>Shared mailers</strong>
          <span>A space in a household or business-address campaign.</span>
          <span class="text-link">Ask about upcoming mailers</span>
        </a>
      </div>
      <p class="svc__more">
        New to these formats? Read how <a href="/advertising-boards">advertising boards</a> and
        <a href="/shared-mailers">shared mailers</a> work.
      </p>
    </div>
  </section>

  {
    area.sections.length > 0 && (
      <section class="section section--paper">
        <div class="container--narrow prose-area">
          {area.sections.map((s) => (
            <div class="block">
              <h2>{s.heading}</h2>
              {s.body.map((p) => (
                <p>{p}</p>
              ))}
            </div>
          ))}
        </div>
      </section>
    )
  }

  {
    area.communities && (
      <section class="section" aria-labelledby="communities-title">
        <div class="container">
          <h2 id="communities-title">{area.communities.heading}</h2>
          <p class="lede">{area.communities.intro}</p>
          <div class="communities">
            {area.communities.items.map((c) => (
              <article class="community" id={c.slug}>
                <h3>{c.name}</h3>
                <p>{c.body}</p>
                <a class="text-link" href={`/contact?area=${area.slug}-${c.slug}`}>
                  Enquire about {c.name}
                </a>
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section section--cream" aria-labelledby="aud-title">
    <div class="container">
      <h2 id="aud-title">Household and business audiences</h2>
      <div class="aud">
        <div>
          <h3>Households</h3>
          <p>{area.audiences.household}</p>
        </div>
        <div>
          <h3>Business addresses</h3>
          <p>{area.audiences.business}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="local-opps">
    <div class="container">
      <h2 id="local-opps">Opportunities in {area.name}</h2>
      {
        areaOpps.length > 0 ? (
          <div class="opp-grid">
            {areaOpps.map((o) => (
              <OpportunityCard opp={o} />
            ))}
          </div>
        ) : (
          <p class="lede">
            There are no published {area.name} opportunities right now. Send an enquiry below and we’ll contact you when
            something suitable is confirmed.
          </p>
        )
      }
      <p class="host-line">
        Know a {area.name} café, restaurant or shop that could host a board?
        <a href="/host-a-board">Suggest a host venue</a>.
      </p>
    </div>
  </section>

  {
    area.faqs && area.faqs.length > 0 && (
      <section class="section section--paper" aria-labelledby="area-faq">
        <div class="container--narrow">
          <h2 id="area-faq">{area.name} questions</h2>
          <FaqList items={area.faqs.map((f) => ({ q: f.q, a: [f.a] }))} />
        </div>
      </section>
    )
  }

  <section class="section" aria-label={`${area.name} enquiry`}>
    <div class="container enquiry-grid">
      <div>
        {
          neighbours.length > 0 && (
            <nav aria-labelledby="nearby-title" class="nearby">
              <h2 id="nearby-title">Nearby areas</h2>
              <ul>
                {neighbours.map((n) => (
                  <li>
                    {n.readiness === 'published' ? (
                      <a href={`/areas/${n.slug}`}>{n.name}</a>
                    ) : (
                      <a href={`/contact?area=${n.slug}`}>{n.name} (enquiries welcome)</a>
                    )}
                  </li>
                ))}
                <li>
                  <a href="/areas">All areas</a>
                </li>
              </ul>
            </nav>
          )
        }
      </div>
      <EnquiryForm
        title={`Ask about advertising in ${area.name}`}
        intro="Your area is already selected. Add any neighbourhoods or streets you care about — an enquiry doesn’t book anything."
        area={area.slug}
        idPrefix={`enq-${area.slug}`}
      />
    </div>
  </section>
</BaseLayout>

<style>
  .area-hero h1 {
    max-width: 20ch;
  }
  .status {
    margin-top: 2rem;
  }
  .status__title {
    font-size: var(--step-1);
  }
  .status__grid {
    display: grid;
    gap: 1rem 2rem;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    align-items: start;
  }
  .status__label {
    font-weight: 600;
    font-size: 0.9rem;
    margin-bottom: 0.4rem;
  }
  .status__summary {
    grid-column: 1 / -1;
    margin: 0;
    color: var(--muted);
  }
  @media (min-width: 900px) {
    .status__grid {
      grid-template-columns: auto auto 1fr;
    }
    .status__summary {
      grid-column: auto;
    }
  }
  .svc {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    margin-top: 1.25rem;
  }
  .svc__card {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.5rem;
    border-radius: var(--radius);
    background: var(--sage);
    text-decoration: none;
    color: var(--ink);
  }
  .svc__card--mailer {
    background: #fbe5cf;
  }
  .svc__card .eyebrow {
    margin: 0;
  }
  .svc__card strong {
    font-family: var(--font-display);
    font-size: var(--step-2);
    color: var(--forest);
    font-weight: 600;
  }
  .svc__card:hover {
    color: var(--ink);
    box-shadow: var(--shadow);
  }
  .svc__more {
    margin-top: 1rem;
    color: var(--muted);
  }
  .block + .block {
    margin-top: 2.5rem;
  }
  .block h2 {
    font-size: var(--step-2);
  }
  .communities {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }
  .community {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.4rem;
    display: flex;
    flex-direction: column;
  }
  .community h3 {
    font-size: var(--step-2);
  }
  .community p {
    color: var(--muted);
    flex: 1;
  }
  .aud {
    display: grid;
    gap: 1.5rem 3rem;
  }
  @media (min-width: 760px) {
    .aud {
      grid-template-columns: 1fr 1fr;
    }
  }
  .aud h3 {
    font-size: var(--step-1);
  }
  .opp-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  }
  .host-line {
    margin-top: 1.5rem;
    padding: 1rem 1.2rem;
    border-radius: var(--radius-sm);
    background: var(--cream);
  }
  .enquiry-grid {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 980px) {
    .enquiry-grid {
      grid-template-columns: 0.6fr 1.4fr;
      align-items: start;
    }
  }
  .nearby h2 {
    font-size: var(--step-2);
  }
  .nearby ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .nearby a {
    font-weight: 600;
  }
</style>
