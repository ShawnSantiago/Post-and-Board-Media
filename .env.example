# Production domain you own, e.g. https://www.example.com (no trailing slash).
# Leave empty for previews: canonicals and the sitemap are omitted and every
# page is marked noindex until this is set.
SITE_URL=

# Enquiry delivery — configure at least one. Never prefix these with PUBLIC_.
# Option A (recommended): an n8n Webhook node's *Production URL*, e.g.
#   https://your-n8n.example.com/webhook/post-and-board-enquiry
# Any other HTTPS endpoint that accepts a JSON POST also works.
ENQUIRY_WEBHOOK_URL=
# Optional shared secret sent as a header on every webhook call. Match it in
# n8n with Authentication → Header Auth (same name and value).
ENQUIRY_WEBHOOK_HEADER_NAME=X-Post-And-Board-Key
ENQUIRY_WEBHOOK_HEADER_VALUE=
# Option B: email through Resend (https://resend.com).
RESEND_API_KEY=
ENQUIRY_EMAIL_TO=
ENQUIRY_EMAIL_FROM=

# Development only. Shows clearly labelled example opportunities.
# The build refuses to run with this on when SITE_URL is set.
DEMO_OPPORTUNITIES=false
