# Production domain you own, e.g. https://www.example.com (no trailing slash).
# Leave empty for previews: canonicals and the sitemap are omitted and every
# page is marked noindex until this is set.
SITE_URL=

# Enquiry delivery — configure at least one. Never prefix these with PUBLIC_.
# Option A: any HTTPS webhook that accepts a JSON POST (Make, Zapier, n8n,
# Google Apps Script, Slack workflow, your own endpoint…).
ENQUIRY_WEBHOOK_URL=
# Option B: email through Resend (https://resend.com).
RESEND_API_KEY=
ENQUIRY_EMAIL_TO=
ENQUIRY_EMAIL_FROM=

# Development only. Shows clearly labelled example opportunities.
# The build refuses to run with this on when SITE_URL is set.
DEMO_OPPORTUNITIES=false
